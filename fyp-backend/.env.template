ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-v2

# TalkJS chat. Keep the secret on the backend only.
TALKJS_APP_ID=
TALKJS_SECRET_KEY=

# Optional remote media storage. Keep disabled for local development unless
# all MinIO values are configured and the endpoint is reachable.
MINIO_ENABLED=false
MINIO_PUBLIC_ENDPOINT=
MINIO_BUCKET=media-medusa
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# WeChat Pay. "mock" is local-only and never charges money; "live" uses API v3.
WECHAT_PAY_ENABLED=true
WECHAT_PAY_MODE=mock
# Legacy compatibility flag. Prefer WECHAT_PAY_MODE for new environments.
WECHAT_PAY_SANDBOX=true
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MCH_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=https://example.test/hooks/payment/pp_wechat_wechat
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY=
WECHAT_PAY_API_BASE_URL=https://api.mch.weixin.qq.com
