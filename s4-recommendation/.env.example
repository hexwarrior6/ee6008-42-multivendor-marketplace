# =====================================================================
# S4 recommender — environment variables (template)
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is git-ignored and must never be committed.
# Real environment variables always take precedence over `.env` values.
# Key meanings are documented in src/recommender/config.py.
# =====================================================================

# --- Data source (pick one) ------------------------------------------
# A) Remote PostgreSQL (Railway):
DATABASE_URL=postgresql://user:pass@host:5432/medusa
# B) Local single-file simulation DB (SQLite):
# DATABASE_URL=sqlite:///E:/path/to/s4-recommendation/simulated_marketplace.db

# --- Optional ---------------------------------------------------------
# Force a "role -> table" mapping (JSON); leave commented for auto-detect.
# DB_ROLE_OVERRIDE={"order":"public.order","line":"public.order_item","product":"public.product"}
# Optional view/click table (enabled once the backend emits such events).
# RECURRING_TABLE=
# Weight of a view/click relative to a purchase (purchase = 1.0).
VIEW_WEIGHT=0.5

# --- Training and output ---------------------------------------------
OUT_DIR=artifacts
FACTORS=32
ITERS=15
K=8
